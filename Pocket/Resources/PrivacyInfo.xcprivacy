<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required as of 2024. Keep this in sync with what the app actually does.
	     EXPAND BEFORE PHASE 4: when the AI planner sends practice history to the
	     Claude proxy, declare the relevant NSPrivacyCollectedDataTypes.

	     ADR 0239: there is no product analytics. The Product Interaction entry
	     ADR 0120 declared for Aptabase went with the SDK; usage figures come from
	     App Store Connect, which Apple collects under the player's own device-level
	     choice and which the app neither reads nor sends. The only data the app
	     itself sends is the contact form below, and only when the player taps Send.

	     NSPrivacyTracking stays false: no IDFA, no ATT prompt, no ad SDK, and no
	     data is ever linked to identity or shared with a data broker. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- ADR 0161: the in-app contact form (Settings ▸ About ▸ Contact Support).
		     Collected ONLY when the player fills the form in and taps Send — there is
		     no background send and no other caller. Delivered to our support inbox
		     via Formspree; see the privacy policy's processor table.

		     Linked = true for all three, and deliberately so: the message and the
		     device details arrive attached to a reply address the player chose to
		     give us, so they are associated with an identity even though the app
		     has no accounts. Declaring them unlinked would be the convenient answer
		     and the wrong one.

		     There is no "customer support" purpose in Apple's vocabulary — the six
		     valid values are ThirdPartyAdvertising, DeveloperAdvertising, Analytics,
		     ProductPersonalization, AppFunctionality and Other. AppFunctionality is
		     the correct one for support correspondence. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- The body of the message the player writes. It is free text, so it is
		     declared as user content even though nothing in the app pre-fills it —
		     what someone chooses to type is theirs and could be anything. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- App version, iOS version and hardware model identifier — the triage
		     details, shown to the player in the form before they send (ADR 0161 D3).
		     Nothing here identifies a device: the model identifier is the hardware
		     generation ("iPhone17,1"), never an IDFV, IDFA or serial.

		     Widened by ADR 0183 to cover one more optional field: a single bounded
		     line summarising the crashes and freezes MetricKit reported — how many,
		     since when, what iOS called the most recent one, and its OS version.
		     It is attached **only** when the player turns "Include in support
		     messages" on (off by default), and it is shown in the form in full
		     before they send, so this stays the same claim ADR 0161 D3 made rather
		     than a wider one. No call stacks, no logs, no file paths.

		     MetricKit itself needs no NSPrivacyAccessedAPITypes entry — it is not a
		     required-reason API. If a diagnostic ever gains free disk space, that
		     *is* NSPrivacyAccessedAPICategoryDiskSpace and needs one. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- The metronome engine reads CACurrentMediaTime() (backed by
		     mach_absolute_time) to measure elapsed session/tick time between
		     in-app events — never wall-clock or across launches. Reason 35F9.1. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>