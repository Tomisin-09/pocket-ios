<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required as of 2024. Keep this in sync with what the app actually does.
	     EXPAND BEFORE PHASE 4: when the AI planner sends practice history to the
	     Claude proxy, declare the relevant NSPrivacyCollectedDataTypes.

	     ADR 0120: anonymous product analytics (Aptabase) are declared below. They
	     are opt-in and off by default, and the vocabulary is a closed Swift enum
	     that cannot carry audio, recordings, journal notes, song titles or the
	     artist name — see Pocket/Core/Analytics/AnalyticsEvent.swift.

	     NSPrivacyTracking stays false: no IDFA, no ATT prompt, no ad SDK, and no
	     data is ever linked to identity or shared with a data broker. Tier 3 is
	     ruled out permanently, so this flag should never need to change. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Mirrors the manifest the Aptabase SDK ships, which we inherit. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<!-- ADR 0161: the in-app contact form (Settings ▸ About ▸ Contact Support).
		     Collected ONLY when the player fills the form in and taps Send — there is
		     no background send and no other caller. Delivered to our support inbox
		     via Formspree; see the privacy policy's processor table.

		     Linked = true for all three, and deliberately so: the message and the
		     device details arrive attached to a reply address the player chose to
		     give us, so they are associated with an identity even though the app
		     has no accounts. Declaring them unlinked would be the convenient answer
		     and the wrong one.

		     There is no "customer support" purpose in Apple's vocabulary — the six
		     valid values are ThirdPartyAdvertising, DeveloperAdvertising, Analytics,
		     ProductPersonalization, AppFunctionality and Other. AppFunctionality is
		     the correct one for support correspondence. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- The body of the message the player writes. It is free text, so it is
		     declared as user content even though nothing in the app pre-fills it —
		     what someone chooses to type is theirs and could be anything. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- App version, iOS version and hardware model identifier — the triage
		     details, shown to the player in the form before they send (ADR 0161 D3).
		     Nothing here identifies a device: the model identifier is the hardware
		     generation ("iPhone17,1"), never an IDFV, IDFA or serial. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- The metronome engine reads CACurrentMediaTime() (backed by
		     mach_absolute_time) to measure elapsed session/tick time between
		     in-app events — never wall-clock or across launches. Reason 35F9.1. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>