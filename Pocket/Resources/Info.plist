<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bundle keys. Previously injected by XcodeGen's `info:` generation; that
	     block was removed (it overwrote this file and dropped the keys below),
	     so they live here. $(…) resolve from project.yml build settings. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<!-- Home-screen / user-facing name. The product brand is "Red Moon"; the
	     internal target, bundle id and scheme stay "Pocket" so signing/CI are
	     untouched (only this display string changed in pocket-086). -->
	<key>CFBundleDisplayName</key>
	<string>Red Moon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Aptabase ingest key (ADR 0120), resolved from the APTABASE_APP_KEY build
	     setting. Write-only: it can post events and read nothing. Empty ⇒ the
	     analytics sink never starts the SDK. -->
	<key>AptabaseAppKey</key>
	<string>$(APTABASE_APP_KEY)</string>
	<!-- Red Moon Oracle backend base URL (ADR 0187 S0), resolved from the
	     POCKET_API_BASE_URL build setting, which is set per-configuration in
	     Configuration/Pocket-{Debug,Release}.xcconfig. Empty ⇒ no proxy is
	     configured and OracleEndpoint reports it unavailable, which is the
	     Release state until S4. Read only by OracleEndpoint. -->
	<key>POCKET_API_BASE_URL</key>
	<string>$(POCKET_API_BASE_URL)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- App uses no non-exempt encryption (no custom crypto; only Apple's standard
	     OS / HTTPS). Declaring this skips the export-compliance prompt on every
	     TestFlight / App Store upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- NO NSAppleMusicUsageDescription. The app never touches the media library:
	     there is no MusicKit import, no MPMediaLibrary/MPMediaPicker, and
	     `SongRef.appleMusic` is constructed only in tests. `MediaPlayer` is
	     imported solely for MPRemoteCommandCenter / MPNowPlayingInfoCenter
	     (lock-screen transport), which needs no permission. Shipping a usage
	     string for an unexercised capability is an over-broad permission — it
	     invites rejection and contradicts the review note's "never Apple Music
	     streaming audio". Re-add it only alongside a real browse path (ADR 0001). -->

	<!-- Playback continues with the screen off during practice. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Two mic surfaces, and the string must name both: the tuner (ADR 0115 —
	     `TunerEngine` taps the input to detect pitch, and it is a FREE surface,
	     so it is often the first prompt a reviewer sees) and practice-take
	     recording (ADR 0069 — captures the user's own playing only; the app
	     never records its own loop/song playback into a file). Surfaced verbatim
	     in the system prompt: keep it specific, and say "Red Moon", the name the
	     user actually sees (CFBundleDisplayName) — never the internal target
	     name "Pocket". Vague or mismatched strings cause App Store rejection. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Red Moon uses the microphone to tune your guitar and to record your own playing as practice takes, so you can listen back to how you sounded. Audio is analysed and stored on your device, and is never uploaded.</string>

	<!-- The file a routine is handed over in (ADR 0188 D3). `UTType(exportedAs:)`
	     in SharedPracticeFile.swift reads this declaration and traps at launch
	     without it, so the two move together.

	     EXPORTED, not imported: this app defines the type. It conforms to
	     public.json so a phone without Red Moon can still open one as text
	     rather than treating it as an opaque blob.

	     There is deliberately NO CFBundleDocumentTypes here. That key declares
	     the app a *handler* — it is what puts Red Moon in the system's Open-with
	     list — and nothing opens one of these until ADR 0188's S2 ships. A
	     declared capability the app does not exercise is exactly what AGENTS.md
	     forbids and what gets a submission rejected, so the handler declaration
	     lands with the code that honours it. UIFileSharingEnabled is not added
	     here either, now or then: ADR 0181 refused it, and the container stays
	     un-browsable.

	     UTTypeDescription is user-facing — it is what Files, Mail and AirDrop
	     print beside the file — so it says Red Moon, never the target name. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>click.decooperations.pocket.practice</string>
			<key>UTTypeDescription</key>
			<string>Red Moon practice</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>redmoonpractice</string>
				</array>
			</dict>
		</dict>
	</array>

	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>